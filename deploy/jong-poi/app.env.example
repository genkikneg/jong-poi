APP_NAME=ジャンポイ
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jong-poi.misoon.net
APP_FORCE_HTTPS=true

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=jong_poi
DB_USERNAME=jong_poi
DB_PASSWORD=replace-with-a-long-random-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=jong_poi_session
SESSION_DOMAIN=jong-poi.misoon.net
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

OPERATIONS_ADMIN_USER_IDS=admin,misooon
OPERATIONS_PASSWORD=replace-with-a-long-random-password
OPERATIONS_VERIFICATION_MINUTES=15
OPERATIONS_RECOVERY_CODE_MINUTES=30

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=replace-with-a-public-app-id
REVERB_APP_KEY=replace-with-a-public-app-key
REVERB_APP_SECRET=replace-with-a-long-random-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
